# =============================================================================
# Sentinel AI - Production Environment Configuration Template
# =============================================================================
# Instructions:
# 1. Copy this file to `.env.production` on your server:
#    cp .env.production.example .env.production
# 2. Fill in all required secrets below.
# 3. Ensure permissions are restricted: chmod 600 .env.production
# =============================================================================

# -- Core Application Environment ---------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Web Server Ports
PORT=80
SSL_PORT=443

# -- Security & JWT Authentication --------------------------------------------
# Generate a cryptographically secure 64-character secret with:
#   openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# -- PostgreSQL 17 Database ----------------------------------------------------
POSTGRES_DB=sentinelai
POSTGRES_USER=sentinelai_admin
# Generate a strong password with: openssl rand -base64 24
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Connection string used by backend and migration engine
DATABASE_URL=postgresql+psycopg://sentinelai_admin:REPLACE_WITH_SECURE_POSTGRES_PASSWORD@postgres:5432/sentinelai

# -- Apache Kafka Messaging ---------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_EVENTS_TOPIC=security-events
KAFKA_SECURITY_EVENTS_DLQ_TOPIC=security-events-dlq
KAFKA_CONSUMER_GROUP=sentinelai-production
KAFKA_CONSUMER_MAX_RETRIES=3
KAFKA_CONSUMER_RETRY_BACKOFF_SECONDS=1.0

# -- AI Reasoning Provider (Debate, Playbooks, SOC Copilot) --------------------
# Supported options: "gemini" or "groq"
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash

# Optional: Groq API Key (if LLM_PROVIDER=groq)
GROQ_API_KEY=

# -- External Threat Intelligence Providers (Optional Enrichment) ------------
THREAT_INTEL_ENRICHMENT_ENABLED=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# -- Automatic Migrations on Startup ------------------------------------------
RUN_MIGRATIONS=true
