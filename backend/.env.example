APP_NAME=SentinelAI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

HOST=0.0.0.0
PORT=8000

DATABASE_URL=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

LOG_LEVEL=INFO

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_EVENTS_TOPIC=security-events
KAFKA_CONSUMER_GROUP=sentinelai-development

# VirusTotal Threat Intelligence Provider
# Obtain a free API key from https://www.virustotal.com
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_TIMEOUT_SECONDS=30.0

# AbuseIPDB Threat Intelligence Provider
# Obtain a free API key from https://www.abuseipdb.com
ABUSEIPDB_API_KEY=
ABUSEIPDB_TIMEOUT_SECONDS=30.0

# AlienVault OTX Threat Intelligence Provider
# Obtain a free API key from https://otx.alienvault.com
OTX_API_KEY=
OTX_TIMEOUT_SECONDS=30.0

# Reasoning provider (V3.23 Multi-Agent Debate Engine)
# Exactly one provider serves a given deployment. There is deliberately NO
# cross-provider fallback: if the selected provider fails, the debate fails and
# is reported as a provider error rather than silently answered by another
# vendor. The provider and model are recorded in each debate's metadata and are
# part of its configuration digest.
#
# LLM_PROVIDER=gemini  -> use GEMINI_* below
# LLM_PROVIDER=groq    -> use GROQ_* below
LLM_PROVIDER=gemini

# Google Gemini. API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=4
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TEMPERATURE=0.0

# Groq. API key: https://console.groq.com/keys
# Note the namespaced model id: Groq publishes this model as
# "openai/gpt-oss-120b". The bare "gpt-oss-120b" is not a valid Groq model id.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Only used when LLM_PROVIDER=groq.
GROQ_TIMEOUT_SECONDS=60.0
GROQ_MAX_RETRIES=4
GROQ_ENDPOINT_BASE=https://api.groq.com
GROQ_MAX_OUTPUT_TOKENS=8192
GROQ_TEMPERATURE=0.0
# Reasoning effort for open-weight models: low | medium | high
GROQ_REASONING_EFFORT=low