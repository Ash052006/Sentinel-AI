          "provenance": "observed",
          "reference": "event"
        },
        {
          "target_type": "infrastructure",
          "target_identifier": "203.0.113.66",
          "relationship": "supports",
          "evidence_type": "dns_query.hostname",
          "provenance": "enriched",
          "reference": "event"
        }
      ]
    },
    {
      "scenario_id": "attribution_partially_supported_one_signal",
