          "target_identifier": "demo-cluster-alpha",
          "relationship": "supports",
          "evidence_type": "ttp_overlap",
          "provenance": "detected",
          "reference": "detection"
        },
        {
          "target_type": "threat_group",
          "target_identifier": "demo-cluster-alpha",
          "relationship": "conflicts",
          "evidence_type": "infrastructure_disjoint",
          "provenance": "enriched",
          "reference": "event"
        }
      ]
    },
    {
      "scenario_id": "attribution_insufficient_evidence",
