{
  "description": "Threat Attribution Engine (app/services/threat_attribution) inputs. Claims are source-backed signals only; the engine derives hypotheses, confidence and status. The claim_id / correlation_id / detection_id / event_id values are placeholders substituted by the runner with the identities produced by the real pipeline - they are NOT persisted evidence ids. Attribution is a hypothesis, never a fact: nothing here asserts an attacker identity as established.",
  "policy": "app.services.threat_attribution.policy.DeterministicAttributionStrategy",
  "min_supporting_signals": 1,
  "attributed_min_supporting_signals": 2,
  "scenarios": [
    {
      "scenario_id": "attribution_attributed_two_supporting_signals",
